// This file is part of OpenBGI (https://openbgi.net).
// SPDX-License-Identifier: GPL-2.0-only
//
// launcher.bpc - OpenBGI's launcher, a Buriko program.
//
// The engine runs it when it is started without a game (docs/dev/launcher.md).  It lists the
// games in the folders the player added - a folder of games, a game's own folder, a .zip or
// an .iso - with a picture of each from the last time it was played, when that was and for
// how long, and starts the one chosen.  Everything on the screen is made by the program
// itself - out of gray patterns (paint.inc) and the engine's built-in font - and laid out
// again whenever the window changes its size, over a stage of moving light (stage.inc).
//
// Screens:
//   Select Game   the games, each with a play button, and a panel about the selected one;
//                 Folders, Edit game, the order of the list, the look of the stage, Start game
//   Game folders  the places that are searched for games; Add folder, Remove, Back
//   Add folder    a folder browser ("../", "dir/", "file.ext"); Add this folder, Cancel
//                 (also "Add patch", for the patches of a game: a .zip or a folder)
//   Edit game     the name, the compatibility (the engine profile), the options and the
//                 patches of a game; Add patch, Remove patch, Remove game, Cancel, Save
//
// Input: the mouse (a double click opens a row), a touch screen (taps; a double tap opens),
// the keyboard (arrows, Enter, Escape, Tab, Page Up / Down, Home, End, Backspace, F5) and a
// pad, whose controls the program gives the same keys (pad_keys).  A folder, a .zip, an .iso
// or one of a game's .arc files dropped on the window is added to the places (drops).
//
// Build: none.  OpenBGI compiles this file itself at every start, from the folder "launcher"
// of the user's data folder, where it writes these sources when they are not there yet.
// To check a change by hand: openbgi bpc launcher.bpc -o launcher._bp
//
// The program is written with the engine's own instructions.  The few of OpenBGI's that it
// needs - a folder's listing, whether a folder is a game, starting one, the settings in
// openbgi.json, gray patterns - are named in obgi_launcher.inc and described in docs/modding/obgi.md.

#engine 1.669
#encoding utf-8

#include "obgi_launcher.inc"

// ---- sizes and limits -------------------------------------------------------------------

#define BASE_W          1280        // the picture the layout is drawn for at a scale of 100
#define BASE_H          720
#define MIN_W           800         // a smaller window gets a picture this size, scaled down by the host
#define MIN_H           480
#define MAX_GAMES       400
#define MAX_FOLDERS     64
#define MAX_PATCHES     16
#define MAX_PROFILES    48
#define MAX_ROWS        40          // rows on the screen at once
#define MAX_BUTTONS     8
#define FIELDS          3           // the fields of "Edit game": name, compatibility, options
#define PATH_LEN        1024        // a native path, UTF-8, with its terminator
#define NAME_LEN        128
#define DOUBLE_MS       400         // two clicks on a row within this time open it
#define FONT_FACE       "ＭＳ Ｐゴシック"  // the interface face: MS PGothic, else the engine's built-in BIZ UDPGothic

// ---- the engine's numbers ---------------------------------------------------------------

#define PM_RGB          1           // pixel modes of "90 11": B G R x, the picture's
#define PM_ARGB         2           // B G R A
#define PRIO_LAYER      8           // the input layer the program reads ("80 18")
#define FX_BLEND        1           // a sprite's blend mode: over what is below, its level how transparent (0 .. 0x100)
#define FX_ADD          2           // added to what is below, its level how much (0 .. 0x100)

#define VK_LBUTTON      1
#define VK_RBUTTON      2
#define VK_BACK         8
#define VK_TAB          9
#define VK_RETURN       13
#define VK_SHIFT        16
#define VK_ESCAPE       27
#define VK_SPACE        32
#define VK_PRIOR        33
#define VK_NEXT         34
#define VK_END          35
#define VK_HOME         36
#define VK_LEFT         37
#define VK_UP           38
#define VK_RIGHT        39
#define VK_DOWN         40
#define VK_F5           116
#define VK_WHEEL_UP     14          // the engine's virtual keys of the wheel (input.h)
#define VK_WHEEL_DOWN   15

// ---- bitmap slots and display priorities -------------------------------------------------

#define BMP_BG          16          // the background: the whole picture
#define BMP_TOP         17          // the bar at the top, with the title and what the screen is
#define BMP_BOTTOM      18          // the bar at the bottom, under the buttons
#define BMP_EMPTY       20          // what an empty list says
#define BMP_PATCHHDR    21
#define BMP_SPIN        19          // the ring that turns while games are looked for
#define BMP_TRACK       22          // the scroll bar
#define BMP_THUMB       23
#define BMP_PLAY        24          // the play button of the rows
#define BMP_PLAY_HOVER  25
#define BMP_FIELD       26          // + 0 name, + 1 compatibility, + 2 options
#define BMP_CURSOR      30          // the light on the selected row
#define BMP_BTN         32          // + button
#define BMP_PANEL       40          // the panel beside the list, with what it says of the selected game:
#define BMP_PANELBOX    41          // .. its box alone,
#define BMP_PANELTXT    44          // .. what it says alone, while that appears,
#define BMP_PANELWIPE   45          // .. and the pattern it appears through
#define BMP_PICTURE     42          // a game's picture as it was read,
#define BMP_HALF        43          // .. and at half that size
#define BMP_PANELPIC    46          // .. and as the panel shows it
#define BMP_ROW         96          // + row
#define BMP_PIC         1000        // + game: its small picture for the list

#define PRIO_BAR        90
#define PRIO_ROW        100
#define PRIO_CURSOR     104
#define PRIO_PLAY       110
#define PRIO_UI         120
#define PRIO_SB         130

// ---- colours ------------------------------------------------------------------------------
// 0xAARRGGBB for what is drawn as boxes (they let the stage shine through), 0xRRGGBB for text

#define COL_BAR_TOP         0xd0080b12
#define COL_BAR_FADE        0x78080b12
#define COL_ROW             0xa60e131c
#define COL_ROW_ALT         0xa6121824
#define COL_ROW_HOVER       0xc41c2535
#define COL_FIELD           0xb0101622
#define COL_PANEL           0xb00c111a
#define COL_BTN             0xd0262d3d
#define COL_BTN_HOVER       0xe8384258
#define COL_BTN_OFF         0x901a1e28
#define COL_TRACK           0x80141a26
#define COL_KNOB            0xe06a7488
#define COL_PIC_FRAME       0x60ffffff
#define COL_PIC_NONE        0x70202838
#define COL_TEXT            0xf2f4f8
#define COL_TEXT_DIM        0xa6aebc
#define COL_TEXT_OFF        0x687080
#define COL_FOCUS           0xffffffff

// ---- the screens and their parts ---------------------------------------------------------

#define SCR_GAMES       0
#define SCR_FOLDERS     1
#define SCR_BROWSE      2
#define SCR_EDIT        3

#define BR_FOLDER       0           // the browser adds a place to search
#define BR_PATCH        1           // the browser adds a patch to the edited game

#define SORT_NAME       0
#define SORT_RECENT     1

// the buttons
#define B_FOLDERS       1
#define B_EDIT          2
#define B_START         3
#define B_ADD_FOLDER    4
#define B_REMOVE_FOLDER 5
#define B_BACK          6
#define B_ADD_CURRENT   7
#define B_CANCEL        8
#define B_ADD_PATCH     9
#define B_REMOVE_PATCH  10
#define B_REMOVE_GAME   11
#define B_SAVE          12
#define B_SORT          13
#define B_LOOK          14

// what the pointer is on
#define H_NONE          0
#define H_ROW           1
#define H_PLAY          2
#define H_BTN           3
#define H_FIELD         4
#define H_TRACK         5
#define H_THUMB         6

// where the keyboard focus is, top to bottom
#define Z_FIELDS        0
#define Z_LIST          1
#define Z_BUTTONS       2

// how a row's text is drawn (row_text)
#define ROW_DIM         1           // an entry that cannot be chosen
#define ROW_PATH        2           // a path: cut at its start when it is too long

// a game's small picture
#define PIC_UNKNOWN     0           // not looked for yet
#define PIC_THERE       1
#define PIC_NONE        2

// ---- the records --------------------------------------------------------------------------

struct Game {
    char path[1024];        // where it is: a folder, a .zip or an .iso (native, UTF-8)
    char name[128];         // the name shown: the player's, else probed
    char probed[128];       // the name the engine found for it, else its file name
    char label[320];        // the row's text: name, or "name (n : file)" when several share it
    char base[128];         // its file name: "TAYUTAMA.ISO", "TAYUTAMA/"
    char detected[16];      // the profile the detection chose
    char profile[16];       // the profile the player chose, "" for automatic
    char played[20];        // when it was started last, "2026-11-17 21:30"; "" for never
    int seconds;            // how long it ran, all in all
    int kind;               // GAME_FOLDER, GAME_ZIP, GAME_ISO
    int pic;                // PIC_...: its small picture,
    int picW;               // .. and that picture's size
    int picH;
};

struct Btn {
    int x; int y; int w; int h;
    int id;                 // B_...
    int enabled;
    int right;              // in the group at the right end of the bar
    int primary;            // drawn in the accent colour
    char text[64];
};

// ---- the program's memory (the engine's global memory, 2 MB: "80 70" 9) ------------------

#define G_VARS      0x1000
global int gW @ G_VARS + 0;             // the picture's size
global int gH @ G_VARS + 4;
global int gScale @ G_VARS + 8;         // the interface scale in percent (px)
global int gScreen @ G_VARS + 12;
global int gBrMode @ G_VARS + 16;
global int gNeedScan @ G_VARS + 20;     // the folders changed: look for games again
global int gScanning @ G_VARS + 24;
global int gMx @ G_VARS + 28;           // the pointer
global int gMy @ G_VARS + 32;
global int gMouseSeen @ G_VARS + 36;
global int gKeyMode @ G_VARS + 40;      // the keyboard (or a pad) was used last: the focus is drawn
global int gLastKind @ G_VARS + 44;     // the last click, for double clicks
global int gLastIdx @ G_VARS + 48;
global int gLastTime @ G_VARS + 52;
global int gHitKind @ G_VARS + 56;      // what the pointer is on (hit)
global int gHitIdx @ G_VARS + 60;
global int gMargin @ G_VARS + 64;       // the layout (layout)
global int gTopH @ G_VARS + 68;         // the bars
global int gBotH @ G_VARS + 72;
global int gInfoShown @ G_VARS + 76;
global int gBarY @ G_VARS + 80;         // the buttons
global int gBtnH @ G_VARS + 84;
global int gFieldCount @ G_VARS + 88;
global int gFieldY @ G_VARS + 92;
global int gFieldH @ G_VARS + 96;
global int gPatchHdrY @ G_VARS + 100;
global int gLstX @ G_VARS + 104;        // the list: its area
global int gLstY @ G_VARS + 108;
global int gLstW @ G_VARS + 112;
global int gLstH @ G_VARS + 116;
global int gRowH @ G_VARS + 120;        // a row's height, and how far it is to the next one
global int gRowPitch @ G_VARS + 124;
global int gRowLines @ G_VARS + 128;
global int gLstN @ G_VARS + 132;        // rows on the screen
global int gLstPlay @ G_VARS + 136;     // the rows have play buttons
global int gLstCount @ G_VARS + 140;    // its items
global int gLstTop @ G_VARS + 144;      // the first item on the screen
global int gLstSel @ G_VARS + 148;      // the selected item, -1 for none
global int gLstHover @ G_VARS + 152;    // the item under the pointer, -1 for none
global int gPlayHover @ G_VARS + 156;   // the item whose play button is under the pointer
global int gPlayD @ G_VARS + 160;       // the play button's size
global int gPlayMade @ G_VARS + 164;    // the size and the colour its bitmaps were made with
global int gPlayCol @ G_VARS + 168;
global int gSbShown @ G_VARS + 172;     // the scroll bar
global int gSbX @ G_VARS + 176;
global int gSbY @ G_VARS + 180;
global int gSbW @ G_VARS + 184;
global int gSbH @ G_VARS + 188;
global int gThumbH @ G_VARS + 192;
global int gKnob @ G_VARS + 196;
global int gBtnCount @ G_VARS + 200;
global int gBtnHover @ G_VARS + 204;
global int gFieldHover @ G_VARS + 208;
global int gFocusZone @ G_VARS + 212;
global int gFocusBtn @ G_VARS + 216;
global int gFocusField @ G_VARS + 220;
global int gGameCount @ G_VARS + 224;
global int gFolderCount @ G_VARS + 228;
global int gProfCount @ G_VARS + 232;
global int gEdit @ G_VARS + 236;        // the game being edited (an index of gGames)
global int gEditProf @ G_VARS + 240;    // its profile: an index of gProfiles, -1 for automatic
global int gEditPatchCount @ G_VARS + 244;
global int gEditSel @ G_VARS + 248;     // the selected patch while the browser is open
global int gBrHandle @ G_VARS + 252;    // the browser's listing (OBGI_DIR_OPEN)
global int gBrHasUp @ G_VARS + 256;     // its first row is "../"
global int gBrEntries @ G_VARS + 260;
global int gBrBad @ G_VARS + 264;       // the folder could not be read
global int gTopSpr @ G_VARS + 268;      // the sprites that are not in a table
global int gBottomSpr @ G_VARS + 272;
global int gEmptySpr @ G_VARS + 276;
global int gPatchHdrSpr @ G_VARS + 280;
global int gTrackSpr @ G_VARS + 284;
global int gThumbSpr @ G_VARS + 288;
global int gCursorSpr @ G_VARS + 292;
global int gPanelSpr @ G_VARS + 296;
global int gPanelTxtSpr @ G_VARS + 300;
global int gLDown @ G_VARS + 304;       // the mouse buttons were down last frame
global int gRDown @ G_VARS + 308;
global int gFont @ G_VARS + 312;        // the interface font's number ("B0 C0")
global int gSort @ G_VARS + 316;        // SORT_...
global int gPicScale @ G_VARS + 320;    // the scale the games' small pictures were read at
global int gPicW @ G_VARS + 324;        // the box of a small picture in a row
global int gPicH @ G_VARS + 328;
global int gPanelShown @ G_VARS + 332;  // the panel beside the list
global int gPanelX @ G_VARS + 336;
global int gPanelW @ G_VARS + 340;
